{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "api_version": 3,
  "version": "1.1.1",
  "name": "mmd/grid--query",
  "title": "Grid of Content (Dynamic Query)",
  "description": "A block to handle dynamic content queries.",
  "category": "mmd-grid-blocks",
  "icon": "database",
  "supports": {
    "anchor": true,
    "customClassName": false
  },
  "attributes": {
    "columns": {
      "type": "string",
      "default": "lg:cols-3"
    },
    "contentTypes": {
      "type": "array",
      "default": ["article"]
    },
    "numPostsToShow": {
      "type": "number",
      "default": 6
    },
    "onePostPerCT": {
      "type": "boolean",
      "default": false
    },
    "categoryTerms": {
      "type": "array",
      "default": []
    },
    "articleTypeTerms": {
      "type": "array",
      "default": []
    },
    "resourceTypeTerms": {
      "type": "array",
      "default": []
    },
    "regionTerms": {
      "type": "array",
      "default": []
    },
    "themeTerms": {
      "type": "array",
      "default": []
    },
    "countryTerms": {
      "type": "array",
      "default": []
    },


    "respectListingExclusions": {
      "type": "boolean",
      "default": false,
      "description": "When enabled, posts marked as 'Exclude from listings' will be hidden from results."
    },

    "preview": {
      "type": "boolean",
      "default": false
    }
  },
  "example": {
    "attributes": {
      "preview": true
    }
  },
  "textdomain": "marameodesign",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}

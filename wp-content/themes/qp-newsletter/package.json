{
  "name": "qp-newsletter",
  "version": "1.0.0",
  "description": "A Marameo Design custom theme.",
  "main": "index.js",
  "scripts": {
    "wp-build": "wp-scripts build --webpack-src-dir=gutenberg/blocks --output-path=gutenberg/build/blocks --webpack-copy-php",
    "wp-start": "wp-scripts start --webpack-src-dir=gutenberg/blocks --output-path=gutenberg/build/blocks --webpack-copy-php",
    "watch": "npm-run-all --parallel tw-watch gulp-watch watch-blocks",
    "build": "npm-run-all --sequential tw-build gulp-build wp-build",
    "tw-build": "npm-run-all tw-default-build tw-editor-build",
    "tw-watch": "npx @tailwindcss/cli -i ./assets/css/style.css -o ./gutenberg/build/css/style.min.css --watch --postcss",
    "tw-default-build": "npx @tailwindcss/cli -i ./assets/css/style.css -o ./gutenberg/build/css/style.min.css --postcss --minify",
    "tw-editor-build": "npx @tailwindcss/cli -i ./assets/css/style-editor.css -o ./gutenberg/build/css/style-editor.min.css --postcss --minify",
    "gulp-build": "npm-run-all --sequential gulp-css gulp-js",
    "gulp-css": "gulp css",
    "gulp-js": "gulp js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "WordPress",
    "Gutenberg",
    "block",
    "editor",
    "tailwindcss"
  ],
  "author": "Marameo",
  "license": "ISC",
  "devDependencies": {
    "@wordpress/block-editor": "^14.15.0",
    "@wordpress/components": "^29.6.0",
    "@wordpress/data": "^10.20.0",
    "@wordpress/element": "^6.20.0",
    "@wordpress/i18n": "^5.20.0",
    "@wordpress/rich-text": "^7.20.0",
    "@wordpress/scripts": "^30.13.0",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^7.0.3",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-dart-sass": "^1.1.0",
    "gulp-load-plugins": "^2.0.8",
    "gulp-merge-media-queries": "^0.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "webpack": "^5.99.7"
  },
  "dependencies": {
    "@10up/block-components": "^1.20.0",
    "@parcel/watcher": "^2.5.0",
    "@tailwindcss/cli": "^4.0.14",
    "@wordpress/blocks": "^14.9.0",
    "@wordpress/icons": "^10.20.0",
    "@wordpress/server-side-render": "^5.20.0",
    "deepmerge": "^4.3.1",
    "lodash": "^4.17.21",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.14"
  }
}
